    if acao == "excluir":
        precisa_confirmar(a, "Excluir a história (apaga os arquivos)")
        st, _ = chamar("DELETE", "/api/projetos/%s" % pid)
        print("HTTP %s" % st)
        print("Excluída.")
        return 0
    raise Falha(400, "ação desconhecida: " + acao)


# ---------------------------------------------------------------- Music

def _progresso_music(g):
    if g["estado"] == "rodando":
        return "%s %s: %d%% (%s), falta %s" % ("prévia" if g["tipo"] == "previa" else "vídeo", g.get("etapa") or "",
                                             round(g["progresso"] * 100), mmss(g.get("decorrido")),
                                             mmss(g["restante"]) if g.get("restante") is not None else "?")
    txt = "último %s: %s" % ("prévia" if g["tipo"] == "previa" else "vídeo", g["estado"])
    if g.get("erro"):
        txt += " (%s)" % g["erro"][:200]
    res = g.get("resultado") or {}
    if res.get("video"):
        txt += " (%s) · %s" % (mmss(res.get("duracao")), link(res["video"]))
    for aviso in (g.get("avisos") or [])[:3]:
        txt += "\n  aviso: " + str(aviso)[:160]
    return txt


def _valor(v):
    low = v.strip().lower()
    if low in ("true", "sim", "ligado", "on"):
        return True
    if low in ("false", "nao", "não", "desligado", "off"):
        return False
    if low in ("null", "none", "padrao", "padrão"):
        return None
    try:
        return int(v) if re.fullmatch(r"-?\d+", v.strip()) else float(v.replace(",", ".")) if re.fullmatch(r"-?\d+[.,]\d+", v.strip()) else v
    except ValueError:
        return v


def cmd_music(a):
    acao = a.acao
    if acao == "progresso":
        st, g = chamar("GET", "/api/gerador/progresso")
        print("HTTP %s" % st)
        print(_progresso_music(g) if g else "Nada renderizando nem renderizado desde que o serviço subiu.")
        return 0
    if acao == "cancelar":
        st, _ = chamar("POST", "/api/gerador/cancelar", {})
        print("HTTP %s" % st)
        print("Renderização cancelada.")
        return 0

    st, e = chamar("GET", "/api/gerador")
    cfg, faixas = e["config"], [f["nome"] for f in e["faixas"]]
    if acao == "estado":
        print("HTTP %s" % st)
        total = sum(f.get("duracao") or 0 for f in e["faixas"])
        print("Faixas no vídeo: %d (%s) de %d na pasta · imagens: %d · clipes: %d" % (
            len(faixas), mmss(total), len(e["na_pasta"]), len(e["imagens"]), len(e["clipes"])))
        t = cfg.get("texto") or {}
        print("Config: modo %s · ordem %s · %ss por imagem · transição %ss · crossfade %ss · ken_burns %s · ajuste %s · "
              "vinheta %s · grao %s · chuva %s · texto %s (%s) · nome_saida %s%s" % (
                  cfg["modo"], cfg["ordem"], cfg["segundos_imagem"], cfg["transicao_s"], cfg["crossfade_s"],
                  cfg["ken_burns"], cfg["ajuste"], cfg["vinheta"], cfg["grao"], cfg["chuva"],
                  "ligado" if t.get("ligado") else "desligado", t.get("posicao"), cfg["nome_saida"],
                  " · clipe " + cfg["clipe"] if cfg["modo"] == "clipe" else ""))
        print("Saída: %s · %s fps · codificador %s · volume alvo %s LUFS" % (
            e.get("resolucao"), e.get("fps"), (e.get("codificador") or {}).get("rotulo", "?"), e.get("alvo_lufs")))
        if e.get("trabalho"):
            print("Agora: " + _progresso_music(e["trabalho"]))
        if e.get("clipes") and cfg["modo"] == "clipe" or a.n_detalhe:
            print("Clipes: " + ", ".join(c["nome"] for c in e["clipes"]))
        return 0
    if acao == "faixas":
        print("HTTP %s" % st)
        no_video = set(faixas)
        for i, f in enumerate(e["faixas"], 1):
            print("%d. %s (%s)" % (i, f["nome"], mmss(f.get("duracao"))))
        fora = [f for f in e["na_pasta"] if f["nome"] not in no_video]
        if fora:
            print("Na pasta mas fora do vídeo: " + ", ".join(f["nome"] for f in fora))
        return 0
    if acao == "saidas":
        print("HTTP %s" % st)
        if not e["saidas"]:
            print("Nenhum vídeo renderizado ainda.")
        for s in e["saidas"][:a.n]:
            print("- %s · %.0f MB · %s · %s" % (s["nome"], s["tamanho"] / 1e6, s["data"].replace("T", " "), link(s["url"])))
        return 0
    if acao == "usar":
        alvo = (a.valores or [""])[0] if len(a.valores or []) == 1 else ", ".join(a.valores or [])
        if alvo.strip().lower() in ("todas", "tudo", "todas as faixas"):
            nomes = [f["nome"] for f in e["na_pasta"]]
        else:
            pedidas = [x.strip() for x in alvo.split(",") if x.strip()]
            por_nome = {f["nome"].lower(): f["nome"] for f in e["na_pasta"]}
            por_titulo = {(f.get("titulo") or "").lower(): f["nome"] for f in e["na_pasta"]}
            nomes, faltam = [], []
            for x in pedidas:
                n = por_nome.get(x.lower()) or por_titulo.get(x.lower())
                (nomes if n else faltam).append(n or x)
            if faltam:
                raise Falha(400, "faixa(s) não encontrada(s): %s. Veja os nomes com: estudio music faixas" % ", ".join(faltam))
        if not nomes:
            raise Falha(400, "nenhuma faixa escolhida")
        st, _ = chamar("PUT", "/api/gerador/config", {"config": cfg, "faixas": nomes})
        print("HTTP %s" % st)
        print("O vídeo vai usar %d faixa(s), nesta ordem: %s" % (len(nomes), ", ".join(nomes)))
        return 0
    if acao == "ajustar":
        if not a.valores:
            raise Falha(400, "use: estudio music ajustar chave=valor (ex.: segundos_imagem=15)")
        novo = json.loads(json.dumps(cfg))
        for par in a.valores:
            chave, sep, v = par.partition("=")
            if not sep:
                raise Falha(400, "use chave=valor: %r" % par)
            partes = chave.strip().split(".")
            alvo = novo
            for p in partes[:-1]:
                alvo = alvo.setdefault(p, {})
            if partes[-1] not in alvo and partes[0] != "texto":
                raise Falha(400, "chave desconhecida: %s. Válidas: %s, texto.ligado/posicao/tamanho/cor" % (
                    chave, ", ".join(k for k in cfg if k not in ("pastas", "texto"))))
            alvo[partes[-1]] = _valor(v)
        st, _ = chamar("PUT", "/api/gerador/config", {"config": novo, "faixas": faixas})
        depois = get("/api/gerador")["config"]
        print("HTTP %s" % st)
        for par in a.valores:
            chave = par.partition("=")[0].strip()
            v = depois
            for p in chave.split("."):
                v = (v or {}).get(p) if isinstance(v, dict) else None
            print("%s = %s" % (chave, json.dumps(v, ensure_ascii=False)))
        return 0
    if acao in ("previa", "renderizar"):
        if a.nome:
            cfg = dict(cfg, nome_saida=a.nome)
        st, g = chamar("POST", "/api/gerador/" + acao, {"config": cfg, "faixas": faixas})
        print("HTTP %s" % st)
        print("%s começou (%d faixas). Acompanhe com: estudio music progresso" % (
            "Prévia" if acao == "previa" else "Vídeo final '%s'" % cfg["nome_saida"], len(faixas)))
        return 0
    raise Falha(400, "ação desconhecida: " + acao)


# ---------------------------------------------------------------- argumentos

class Argumentos(argparse.ArgumentParser):
    """Erro de uso também na saída normal, no mesmo formato (o agente não lê a saída de erro)."""

    def error(self, message):
        print("HTTP 400\nErro de uso: %s\n" % message)
        self.print_usage(sys.stdout)
        sys.exit(2)


def main():
    p = Argumentos(prog="estudio", description="Estúdio de vídeo pela API (Cortador, Histórias, Music)")
    sub = p.add_subparsers(dest="area", required=True)
    sub.add_parser("status")
    sub.add_parser("custos")

    c = sub.add_parser("cortes")
    c.add_argument("acao", choices=["canais", "novo", "lista", "ver", "produzir", "descartar", "voltar", "titulo", "canal",
                                    "enviar", "cancelar", "repetir", "remover"])
    c.add_argument("trabalho", nargs="?")
    c.add_argument("corte", nargs="?")
    c.add_argument("valor", nargs="?")
    c.add_argument("--url")
    c.add_argument("--canal")
    c.add_argument("--visual")
    c.add_argument("--formato", choices=FORMATOS)
    c.add_argument("--legenda", choices=["new", "old"])
    c.add_argument("--n", type=int, default=8)
    c.add_argument("--todos", action="store_true")
    c.add_argument("--confirmado", action="store_true")

    h = sub.add_parser("historias")
    h.add_argument("acao", choices=["canais", "nova", "lista", "ver", "texto", "eventos", "aprovar-historia",
                                    "aprovar-imagens", "refazer-historia", "recomecar", "refazer-imagens", "continuar",
                                    "refazer-cena", "enviar", "excluir"])
    h.add_argument("id", nargs="?")
    h.add_argument("n_cena", nargs="?")
    h.add_argument("--canal")
    h.add_argument("--assunto")
    h.add_argument("--revisar", action="store_true")
    h.add_argument("--prompt")
    h.add_argument("--n", type=int, default=8)
    h.add_argument("--confirmado", action="store_true")

    m = sub.add_parser("music")
    m.add_argument("acao", choices=["estado", "faixas", "usar", "ajustar", "previa", "renderizar", "progresso",
                                    "cancelar", "saidas"])
    m.add_argument("valores", nargs="*")
    m.add_argument("--nome")
    m.add_argument("--n", type=int, default=8)
    m.add_argument("--detalhe", dest="n_detalhe", action="store_true")

    a = p.parse_args()
    if a.area == "cortes" and a.acao in ("ver", "produzir", "descartar", "voltar", "titulo", "canal", "enviar",
                                          "cancelar", "repetir", "remover") and not a.trabalho:
        print("HTTP 400\nErro: informe o trabalho (ex.: 20261002-020750-1f02 ou ultimo)")
        return 1
    if a.area == "historias" and a.acao not in ("canais", "nova", "lista") and not a.id:
        print("HTTP 400\nErro: informe o id da história (número ou ultima)")
        return 1
    try:
        return {"status": cmd_status, "custos": cmd_custos, "cortes": cmd_cortes, "historias": cmd_historias,
                "music": cmd_music}[a.area](a)
    except Falha as f:
        print("HTTP %s" % f.status)
        print("Erro: " + f.texto)
        return 1


if __name__ == "__main__":
    sys.exit(main())
