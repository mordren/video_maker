    print("#%s %s · %s · canal %s · custo %s" % (p["id"], (p.get("historia") or {}).get("titulo") or p["assunto"],
                                              STATUS_HIST.get(p["status"], p["status"]), p["canal"]["nome"],
                                              usd((p.get("custos") or {}).get("total"))))
    print("Assunto: " + p["assunto"])
    if p.get("modo"):
        print("Modo narrativo: " + p["modo"])
    if p.get("ressalva"):
        print("ATENÇÃO, ressalva do juiz: " + p["ressalva"][:300])
    if p.get("erro"):
        print("Erro: " + p["erro"][:300])
    cenas = p.get("cenas") or []
    if cenas:
        ok = sum(1 for c in cenas if c.get("status") == "ok")
        print("Cenas com imagem: %d de %d" % (ok, len(cenas)))
    arq = p.get("arquivos") or {}
    for k, rot in (("video", "vídeo"), ("folha", "folha de contato (todas as imagens)"), ("narracao", "narração")):
        if arq.get(k):
            print("%s: %s" % (rot.capitalize(), link(arq[k])))
