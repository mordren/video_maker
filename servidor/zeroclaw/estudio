def _youtube(url):
    """Aceita link completo, youtu.be, shorts ou só o id; tira o que vem depois do id (&t=, &list=...)."""
    url = url.strip().strip("<>\"'")
    m = re.search(r"(?:v=|youtu\.be/|/shorts/|/live/|/embed/)([\w-]{11})", url)
    if m:
        return "https://www.youtube.com/watch?v=" + m.group(1)
    if re.fullmatch(r"[\w-]{11}", url):
        return "https://www.youtube.com/watch?v=" + url
    return url


def _trabalho_id(tid):
    if tid.lower() in ("ultimo", "último", "ultima", "última"):
        lista = get("/api/trabalhos")["trabalhos"]
        if not lista:
            raise Falha(404, "não há trabalhos")
        return lista[0]["id"]
    return tid


