    proximo = {"aguardando_historia": "estudio historias aprovar-historia %s (leia antes com: estudio historias texto %s)" % (i, i),
               "aguardando_imagens": "estudio historias aprovar-imagens %s (ou refazer-cena %s N)" % (i, i),
               "erro": "estudio historias continuar %s (ou recomecar %s)" % (i, i),
               "interrompido": "estudio historias continuar %s" % i,
               "pronto": "mostrar o vídeo ao João; publicar só se ele mandar (enviar %s --confirmado)" % i}.get(p["status"])
    if proximo:
        print("Próximo passo: " + proximo)


