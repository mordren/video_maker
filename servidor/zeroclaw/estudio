# ---------------------------------------------------------------- HTTP

class Falha(Exception):
    def __init__(self, status, texto):
        super().__init__(texto)
        self.status, self.texto = status, texto


def chamar(metodo, caminho, corpo=None, tempo=40):
    dados = json.dumps(corpo, ensure_ascii=False).encode("utf-8") if corpo is not None else None
    req = urllib.request.Request(BASE + caminho, data=dados, method=metodo,
                                 headers={"Accept": "application/json", "User-Agent": "zeroclaw-estudio/1.0"})
    if dados is not None:
        req.add_header("Content-Type", "application/json; charset=utf-8")
    for tentativa in (1, 2):  # leitura repete uma vez em erro de rede ou 5xx; ação nunca (não duplica)
        try:
            with urllib.request.urlopen(req, timeout=tempo) as r:
                bruto = r.read().decode("utf-8", "replace")
                return r.status, (json.loads(bruto) if bruto.strip() else None)
        except urllib.error.HTTPError as e:
            bruto = e.read().decode("utf-8", "replace")
            if e.code >= 500 and metodo == "GET" and tentativa == 1:
                continue
            try:
                d = json.loads(bruto)
                msg = d.get("erro") or d.get("detail") or bruto
            except (ValueError, AttributeError):
                msg = bruto[:400]
            raise Falha(e.code, msg if isinstance(msg, str) else json.dumps(msg, ensure_ascii=False)[:400])
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            if metodo == "GET" and tentativa == 1:
                continue
            raise Falha(0, "sem conexão com o Estúdio (%s): %s" % (BASE, getattr(e, "reason", e)))


def get(caminho):
    return chamar("GET", caminho)[1]


def link(caminho):
    return BASE + caminho if caminho else ""


def usd(v):
    return "US$ %.4f" % float(v or 0)


def mmss(s):
    s = int(round(float(s or 0)))
    return "%d:%02d" % (s // 60, s % 60) if s < 3600 else "%d:%02d:%02d" % (s // 3600, s % 3600 // 60, s % 60)


def precisa_confirmar(a, o_que):
    if not a.confirmado:
        raise Falha(400, "%s precisa de --confirmado. Só use quando o João pedir isso com todas as letras." % o_que)


