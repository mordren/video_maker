def _projeto_id(pid):
    if str(pid).lower() in ("ultima", "última", "ultimo", "último"):
        lista = get("/api/projetos")
        if not lista:
            raise Falha(404, "não há histórias")
        return lista[0]["id"]
    if not str(pid).lstrip("#").isdigit():
        raise Falha(400, "id da história é um número (ex.: 12) ou \"ultima\"")
    return int(str(pid).lstrip("#"))


