# Copie para .env e preencha. O .env nunca vai para o Git.
OPENROUTER_API_KEY=sk-or-v1-...
# Use uma chave só para o programa, com limite de gasto definido no painel do Pollinations.
POLLINATIONS_API_KEY=sk_...

# Modelos (padrões do roteiro)
# MODELO_TEXTO=deepseek/deepseek-v4.1-flash
# MODELO_JUIZ=typesafe/jev-1.13
# Modelo só dos ganchos (Opus, US$ 4/M de entrada); o resto da história usa MODELO_TEXTO
# MODELO_GANCHO=anthropic/claude-opus-5.5
# MODELO_IMAGEM=black-forest-labs/flux.2-klein-4b

# Teto do laço da história (escrita + Jev), em US$
# LACO_TETO_USD=0.01

# Protege a API quando ela for acessada de fora deste computador
# ESTUDIO_API_TOKEN=

# Caminho do humanizer-br (padrão: a pasta "Humanizer br-v1" ao lado do programa)
# HUMANIZER_SKILL=

# Publicador (fila de postagem na rede local)
# PUBLICADOR_URL=http://192.168.31.133:8080
